# Resort section: desired order of modes on layer 1, to allow
# arbitrary mode-combination schemes. The numbers entered in
# the basis and layers sections apply to the resorted order

$resort
 1  2  3  4  5  6 /
$end-resort

# Basis section: number of basis functions per DOF/mode
# first line: primitive basis for individual DOFs
# subsequent lines: basis for modes which combine DOFs

$basis
16 16 16 16 10 10 /
10 10 10 10 10 10 /
 100   100   100  /
  12    16   100  /
    357      100  /
     40       40  /
         40       /
$end-basis

# Layers section: number of DOFs/modes to combine from previous layer
# The first (primitive basis) layer is implied, with 1,1,...,1, so
# input begins with the second layer

$layers
1 1 1 1 1 1 /
 2   2   2  /
 1   1   1  /
   2     1  /
   1     1  /
      2     /
$end-layers

# Truncate section: for truncation nodes list basis truncation criteria
# format: INTEGER  INTEGER    INTEGER  INTEGER  INTEGER /
#           layer     node  max-nmode  max-sum   max-qn /
# NOTES:
# * list only truncation nodes in this section (other nodes -> error)
# * truncation nodes that are not listed follow rules in 'CP.inp'
# * set [max-nmode,max-sum,max-qn] to <0 to include full index range
$truncate
2 2  2 14 10 /
2 4  1 10 12 /
4 1  2  5 -1 /
4 2  1 -1  8 /
6 1  2 -2 -2 /
6 2 -1  6  6 /
$end-truncate


